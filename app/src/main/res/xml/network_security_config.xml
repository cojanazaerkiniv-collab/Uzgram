<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production domains — always HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">uzgram.online</domain>
        <domain includeSubdomains="true">cdn.uzgram.online</domain>
        <domain includeSubdomains="true">ws.uzgram.online</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Development: allow cleartext on local/debug only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
    </domain-config>
</network-security-config>
